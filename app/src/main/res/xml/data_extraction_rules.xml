<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted database and hardware-bound Keystore preferences from cloud backup -->
        <exclude domain="database" path="lumi.db" />
        <exclude domain="database" path="lumi.db-wal" />
        <exclude domain="database" path="lumi.db-shm" />
        <exclude domain="database" path="lumi.db-journal" />
        <exclude domain="sharedpref" path="lumi_secure_db_prefs.xml" />
        <exclude domain="sharedpref" path="androidx.security.crypto.master_key_preference.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumi_secure_db_prefs.xml" />
        <exclude domain="sharedpref" path="androidx.security.crypto.master_key_preference.xml" />
    </device-transfer>
</data-extraction-rules>
